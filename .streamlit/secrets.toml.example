# Modèle de secrets — NE PAS mettre de vrai mot de passe dans ce fichier.
#
# EN LOCAL (facultatif) : copie ce fichier en `.streamlit/secrets.toml` et
# renseigne l'URL de ta base. Sans ce fichier, l'app utilise SQLite en local,
# ce qui suffit pour développer.
#
# EN LIGNE (Streamlit Community Cloud) : ne pousse jamais secrets.toml sur
# GitHub (il est dans .gitignore). Colle plutôt le contenu ci-dessous dans
# l'interface : ton app > Settings > Secrets.
#
# L'URL est fournie par ton hébergeur de base :
#   - Supabase : Project Settings > Database > Connection string > URI
#   - Neon     : Dashboard > Connection Details > Connection string
# Garde le paramètre sslmode=require.

[postgres]
url = "postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_DE_LA_BASE?sslmode=require"

# Assistant IA (Google Gemini) — facultatif. Sans clé, le chat IA est
# simplement masqué ; le reste de l'app fonctionne normalement.
#
# Récupère une clé sur https://aistudio.google.com/apikey (format « AIza… » ou
# « AQ.… » selon l'ancienneté du compte — les deux marchent). NE la mets PAS
# dans le code ni sur GitHub :
#   - EN LOCAL : copie ce fichier en `.streamlit/secrets.toml` et colle la clé.
#   - EN LIGNE : ton app > Settings > Secrets, colle-y ce bloc.
# La clé reste côté serveur ; elle n'est jamais envoyée au navigateur.
[gemini]
api_key = "colle-ta-cle-ici..."
# Modèle facultatif (défaut : gemini-2.0-flash — gratuit, rapide).
# model = "gemini-2.0-flash"
